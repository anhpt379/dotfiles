{
  "title": "macOS apps",
  "rules": [
    {
      "description": "macOS: Open Chrome with COMMAND+CONTROL+C",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "c",
            "modifiers": {
              "mandatory": ["command", "control"]
            }
          },
          "to": [
            {
              "shell_command": "open -a 'Google Chrome.app' && open -g ~/Applications/MoveCursorToCenterOfActiveWindow.app"
            }
          ]
        }
      ]
    },
    {
      "description": "macOS: Open Kitty with COMMAND+CONTROL+K",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "k",
            "modifiers": {
              "mandatory": ["command", "control"]
            }
          },
          "to": [
            {
              "shell_command": "open -a Kitty.app && open -g ~/Applications/MoveCursorToCenterOfActiveWindow.app"
            }
          ]
        }
      ]
    },
    {
      "description": "macOS: Open Zoom with COMMAND+CONTROL+Z",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "z",
            "modifiers": {
              "mandatory": ["command", "control"]
            }
          },
          "to": [
            {
              "shell_command": "open -a Zoom.us.app && open -g ~/Applications/MoveCursorToCenterOfActiveWindow.app"
            }
          ]
        }
      ]
    },
    {
      "description": "macOS: Open Slack with COMMAND+CONTROL+S",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "s",
            "modifiers": {
              "mandatory": ["command", "control"]
            }
          },
          "to": [
            {
              "shell_command": "open -a Slack.app && open -g ~/Applications/MoveCursorToCenterOfActiveWindow.app"
            }
          ]
        }
      ]
    },
    {
      "description": "macOS: Open Finder with COMMAND+CONTROL+F",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "f",
            "modifiers": {
              "mandatory": ["command", "control"]
            }
          },
          "to": [
            {
              "shell_command": "open -a Finder.app && open -g ~/Applications/MoveCursorToCenterOfActiveWindow.app"
            }
          ]
        }
      ]
    },
    {
      "description": "macOS: Switch to next app with COMMAND+CONTROL+N",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "n",
            "modifiers": {
              "mandatory": ["command", "control"]
            }
          },
          "to": [
            {
              "key_code": "tab",
              "modifiers": ["option"]
            }
          ]
        }
      ]
    },
    {
      "description": "macOS: Switch to previous app with COMMAND+CONTROL+P",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "p",
            "modifiers": {
              "mandatory": ["command", "control"]
            }
          },
          "to": [
            {
              "key_code": "p",
              "modifiers": ["option"]
            }
          ]
        }
      ]
    }
  ]
}
