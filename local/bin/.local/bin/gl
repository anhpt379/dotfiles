#!/bin/bash
#
# gl - interactive git log browser built on fzf
#
# Renders `git log` into an fzf picker with a side-by-side diff preview
# (via diff-so-fancy) and keybindings for the common things you want to
# do with a commit once you have found it. The script changes behavior
# based on the name it is invoked under (gl / gd / gg), so
# symlink it as needed.
#
# Usage:
#   gl                      Browse all commits on the current branch
#                           (capped at 15000).
#   gl -N                   Same, but limit to the last N commits, e.g.
#                           `gl -200`. Works with every invocation mode.
#   gl <file>               Follow the history of <file> across renames
#                           (git log --follow <file>).
#   gl <file>:<line>        Show the history of a single line in a file
#                           (git log -L <line>,<line>:<file>).
#
#   gd                      Browse commits showing their patch with zero
#                           context lines (git log -p --unified=0). Use
#                           when symlinked as `gd`.
#
#   gg <pat>                Pickaxe search: list commits whose diff adds
#                           or removes <pat> (case-insensitive,
#                           git log -i -G).
#   gg <pat> <file>         Same pickaxe, restricted to <file> (and
#                           following renames).
#
# Interactive keys (inside the fzf picker):
#   Enter        Open the selected commit with `git show` (full diff).
#   Ctrl-/       Toggle the diff preview pane.
#   Ctrl-S       Toggle fzf sort.
#   Ctrl-Y       Copy the full commit hash to the clipboard (pbcopy).
#   Ctrl-C       Copy the commit message body to the clipboard.
#   Ctrl-O       Open the commit on the origin remote's web UI. Refuses
#   Ctrl-Alt-O   if the commit has not been pushed yet.
#   Ctrl-R       Start an interactive rebase from the selected commit
#                (git rebase -i --rebase-merges <hash>) and exit fzf.
#   Ctrl-]       Run `git push --force-with-lease` and exit fzf. Useful
#                immediately after a Ctrl-R rebase.
#
# Exits with status 1 if the current directory is not a git repository.

git rev-parse HEAD >/dev/null || exit 1

get_commit_hash="echo {} | grep -o '^[a-f0-9]\{7,40\} ' | head -1 | xargs"
view_commit="${get_commit_hash} | xargs -I % git show --color=always %"
rebase_commit="${get_commit_hash} | xargs -I % git rebase -i --rebase-merges %"
preview_commit="${get_commit_hash} | \
  xargs -I % git show --color=always % | diff-so-fancy | less --tabs=4 -RX"
open_in_browser="${get_commit_hash} | \
  xargs -I \# sh -c \"if git log origin/HEAD..HEAD --pretty=format:%h --no-patch | grep -q #; then echo 'This commit # is not in remote yet.'; else open https://\$(git config remote.origin.url | sed 's/^git@//' | sed 's/\.git$//' | sed 's/:/\//')/commit/#; fi\""

copy_commit_hash="${get_commit_hash} | xargs git rev-parse | tr -d '\n' | pbcopy"
copy_commit_message="${get_commit_hash} | xargs -I % git log -n 1 --format=%B $ | pbcopy"

cmd_name=$(basename "$0")
num_commits=15000
args_count=0
args_array=()
for i in "$@"; do
  if [[ $i == -* ]]; then
    num_commits=$(echo "$i" | cut -c2-)
  else
    args_array+=("$i")
    ((args_count++))
  fi
done

if [ "${cmd_name}" = "gl" ]; then
  if [ "${args_count}" -eq 1 ]; then
    IFS=: read -r file line <<< ${args_array[0]}

    if test -z $line; then
      args="--follow $file"
    else
      args="-L $line,$line:$file"
    fi
  fi
elif [ "${cmd_name}" = "gd" ]; then
  args="-p --unified=0"
else
  if [ "${args_count}" -eq 1 ]; then
    args="-i -G'${args_array[0]}'"
  elif [ "${args_count}" -eq 2 ]; then
    args="-i --follow -G'${args_array[0]}' -- '${args_array[1]}'"
  fi
fi
git_cmd="git log -${num_commits} \
                 --color=always \
                 --format='%C(green)%h%C(red)%d%Creset %C(reset)%s %C(#696969)%b(%aN - %cr)' \
                 ${args} 2>/dev/null"

red="$(tput setaf 1)"
reset="$(tput sgr0)"
eval "${git_cmd}" |
  tr "\n" " " |
  sed "s/\`//g" |
  sed -E "s/\\x1b\\[32m[a-f0-9]{7,}+/\\n&/2g" |
  fzf \
    --reverse \
    --tiebreak=index \
    --no-multi \
    --ansi \
    --height=100% \
    --exact \
    --preview="${preview_commit}" \
    --header="${red}CTRL-Y${reset} to yank commit hash, ${red}CTRL-C${reset} to copy commit message, ${red}CTRL-R${reset} to rebase -i, ${red}CTRL-O${reset} to open commit in browser, ${red}CTRL-/${reset} to toggle preview, ${red}CTRL-S${reset} to toggle sort" \
    --bind="enter:execute/${view_commit}/" \
    --bind="ctrl-y:execute-silent/${copy_commit_hash}/" \
    --bind="ctrl-c:execute-silent/${copy_commit_message}/" \
    --bind="ctrl-o:execute/${open_in_browser}/" \
    --bind="ctrl-alt-o:execute/${open_in_browser}/" \
    --bind="ctrl-r:execute/${rebase_commit}/+abort" \
    --bind="ctrl-]:execute/git push --force-with-lease/+abort"
